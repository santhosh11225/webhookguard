{
  "name": "webhookguard-backend",
  "version": "1.0.0",
  "description": "WebhookGuard Backend API - Automated Webhook Testing & Reliability Engine",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
